{
  "name": "@quincyhuang/webterm",
  "version": "1.0.0",
  "description": "A password-protected terminal in your browser, built on xterm.js and node-pty",
  "keywords": [
    "terminal",
    "xterm",
    "xterm.js",
    "web-terminal",
    "shell",
    "pty",
    "node-pty"
  ],
  "homepage": "https://github.com/quincyyhuang/webterm#readme",
  "bugs": {
    "url": "https://github.com/quincyyhuang/webterm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quincyyhuang/webterm.git"
  },
  "license": "MIT",
  "author": "Quincy Huang <quincyyhuang@gmail.com>",
  "type": "module",
  "bin": {
    "webterm": "bin/webterm.js"
  },
  "files": [
    "bin/",
    "lib/",
    "public/"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node bin/webterm.js",
    "set-password": "node bin/webterm.js set-password",
    "install-service": "node bin/webterm.js install-service",
    "uninstall-service": "node bin/webterm.js uninstall-service",
    "update-themes": "node scripts/update-themes.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.2"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  },
  "publishConfig": {
    "access": "public"
  }
}
